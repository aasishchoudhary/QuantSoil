APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://gods_eye:gods_eye@localhost:5432/gods_eye
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=gods-eye-evidence

# Analyst API authentication. Set mode=required and provide a strong secret in production.
ANALYST_AUTH_MODE=optional
ANALYST_BEARER_TOKEN=

# Optional licensed AIS GeoJSON endpoint. Configure only a provider you are authorized to use.
QUANTSOIL_AIS_GEOJSON_URL=
QUANTSOIL_AIS_BEARER_TOKEN=
QUANTSOIL_AIS_PROVIDER_ID=
QUANTSOIL_AIS_LICENSE_ID=

# Optional explicitly authorized camera metadata GeoJSON endpoint (metadata only).
QUANTSOIL_AUTHORIZED_CAMERA_GEOJSON_URL=
QUANTSOIL_AUTHORIZED_CAMERA_BEARER_TOKEN=
QUANTSOIL_AUTHORIZED_CAMERA_PROVIDER_ID=
QUANTSOIL_AUTHORIZED_CAMERA_LICENSE_ID=

# Frontend build-time settings. Never commit real tokens.
VITE_ANALYST_API_BASE=/v1/analyst
VITE_CESIUM_ION_TOKEN=
