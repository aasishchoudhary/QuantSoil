APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://gods_eye:gods_eye@localhost:5432/gods_eye
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_OPEN_TIMEOUT_SECONDS=15
DB_POOL_RECONNECT_SECONDS=60
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=gods-eye-evidence
EVIDENCE_STORAGE=s3
EVIDENCE_LOCAL_ROOT=~/.quantsoil/evidence
