{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gods-eye-world-intelligence.dev/schemas/source-record.schema.json",
  "title":"Source Record",
  "type":"object",
  "required":["source_record_id","payload","observed_at","acquired_at"],
