{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gods-eye-world-intelligence.dev/schemas/entity-match.schema.json",
  "title": "Entity Match",
  "description": "Probabilistic observation-to-entity assertion with explicit uncertainty and evidence.",
  "type": "object",
  "required": ["entity_id","observation_id","score","method","evidence_refs"],
  "properties": {
    "entity_id": {"type":"string","minLength":1},
    "observation_id": {"type":"string","minLength":1},
    "score": {"type":"number","minimum":0,"maximum":1},
    "method": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties": false
}
