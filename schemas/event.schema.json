{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://gods-eye-world-intelligence.dev/schemas/event.schema.json","title":"Event","type":"object","required":["event_id","kind","occurred_at","emitted_at","payload","evidence_ids"],"properties":{"event_id":{"type":"string","minLength":1},"kind":{"enum":["observed","derived","predicted"]},"occurred_at":{"type":"string","format":"date-time"},"emitted_at":{"type":"string","format":"date-time"},"payload":{"type":"object"},"evidence_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"derivation":{"type":["string","null"]}},"allOf":[{"if":{"properties":{"kind":{"const":"observed"}}},"then":{"properties":{"derivation":{"type":"null"}}}},{"if":{"properties":{"kind":{"enum":["derived","predicted"]}}},"then":{"required":["derivation"],"properties":{"derivation":{"type":"string","minLength":1}}}}],"additionalProperties":false}