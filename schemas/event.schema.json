{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gods-eye-world-intelligence.dev/schemas/event.schema.json",
  "title": "Event",
  "description": "Observed, derived, or predicted event with mandatory provenance.",
  "type": "object",
  "required": ["event_id", "event_type", "state", "occurred_at", "evidence_refs", "payload"],
  "properties": {
    "event_id": {"type":"string","minLength":1},
    "event_type": {"type":"string","minLength":1},
    "state": {"enum":["observed","derived","predicted"]},
    "occurred_at": {"type":"string","format":"date-time"},
    "evidence_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "payload": {"type":"object"},
    "confidence": {"type":["number","null"],"minimum":0,"maximum":1},
    "valid_from": {"type":["string","null"],"format":"date-time"},
    "valid_to": {"type":["string","null"],"format":"date-time"}
  },
  "additionalProperties": false
}
